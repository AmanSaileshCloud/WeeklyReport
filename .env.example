# Copy this file to .env and fill in values for your environment.
# All variables are optional — built-in defaults work for local development.

# ── Database ────────────────────────────────────────────────────────────────
# Supabase / PostgreSQL connection string (production)
# When set, PostgreSQL is used. When unset, SQLite is used (local dev only).
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Path to the SQLite user database (local dev only, ignored if DATABASE_URL is set)
# DB_PATH=/data/users.db

# ── Report data & output ────────────────────────────────────────────────────
# Path to the default CSV report file
# REPORT_PATH=/data/reports/zoho_weekly_report.csv

# Directory where chart PNGs are written during report generation
# GRAPH_DIR=/tmp/graphs

# Path to the company logo used in PDF reports
# LOGO_PATH=/app/assets/logo.png

# Default PDF output path (used by CLI / Flask; Streamlit uses temp files)
# OUTPUT_PDF=/data/output/weekly_report.pdf

# ── Branding ────────────────────────────────────────────────────────────────
# Company name shown in reports and the dashboard header
# COMPANY_NAME=Workmates

# Number of days of ticket data to analyse (default: 7)
# DAYS_RANGE=7

# ── Flask (app.py only) ─────────────────────────────────────────────────────
# Directory for temporary CSV uploads
# UPLOAD_FOLDER=/tmp/uploads

# Directory where generated PDFs are held until download
# OUTPUT_FOLDER=/tmp/outputs

# Flask port (default: 5000)
# PORT=5000

# Set to "true" to enable Flask debug mode (never use in production)
# DEBUG=false
